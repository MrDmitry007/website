          <option value="17">17 лет (смены до 4 часов)</option>
        </select>
      </div>

      <div>
        <label class="block text-slate-300 font-semibold mb-1">Телефон или Telegram для связи менеджера:</label>
        <input type="text" id="applyUserContact" placeholder="@username или +7..." value="@artem_teen" class="w-full bg-brand-surface text-white px-3.5 py-2.5 rounded-xl border border-brand-border focus:outline-none focus:border-brand-mint">
      </div>

      <label class="flex items-start gap-3 p-3 bg-brand-surface rounded-xl border border-brand-border cursor-pointer select-none">
        <input type="checkbox" id="applyConsentCheckbox" checked class="mt-0.5 rounded text-brand-mint focus:ring-0">
        <span class="text-[11px] text-slate-300 leading-snug">
          Родители в курсе и не возражают против подработки во внеучебное время (ст. 63 ТК РФ)
        </span>
      </label>
    </div>

    <div class="mt-6 flex gap-3">
      <button onclick="submitApplication()" class="w-full bg-brand-mint hover:bg-brand-mintHover text-brand-dark font-heading font-black text-sm py-3.5 rounded-xl transition-all shadow-neo active:translate-x-0.5 active:translate-y-0.5">
        Подтвердить отклик ⚡
      </button>
    </div>

    <p class="text-[10px] text-slate-400 text-center mt-3">
      Оплата за эту смену уже заблокирована на счете сервиса. Тебя никто не обманет.
    </p>
  </div>
</div>

<!-- Auth Modal -->
<div id="authModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-brand-card rounded-3xl border-2 border-brand-border max-w-sm w-full p-8 relative">
    <button onclick="toggleAuthModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white bg-brand-surface p-2 rounded-xl transition-colors">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>

    <div class="text-center">
      <div class="w-14 h-14 bg-gradient-to-tr from-brand-indigo to-brand-purple rounded-2xl flex items-center justify-center mx-auto mb-4 border border-brand-mint text-brand-mint shadow-neo">
        <i data-lucide="send" class="w-7 h-7"></i>
      </div>
      <h3 class="font-heading font-bold text-lg text-white">Вход через Telegram</h3>
      <p class="text-xs text-slate-400 mt-1">Без паролей, подтверждений почты и бюрократии</p>
    </div>

    <div class="mt-6 space-y-3">
      <button onclick="simulateTgLogin()" class="w-full bg-[#2AABEE] hover:brightness-110 text-white font-semibold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition-all">
        <i data-lucide="send" class="w-4 h-4"></i>
        Продолжить как @artem_teen
      </button>
      <button onclick="toggleAuthModal()" class="w-full bg-brand-surface hover:bg-brand-cardHover text-slate-300 text-xs py-2.5 rounded-xl border border-brand-border transition-colors">
        Закрыть
      </button>
    </div>
  </div>
</div>

<!-- Applications Modal -->
<div id="applicationsModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden items-center justify-center p-4">
  <div class="bg-brand-card rounded-3xl border-2 border-brand-border max-w-lg w-full p-6 relative max-h-[90vh] overflow-y-auto">
    <button onclick="closeApplicationsModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white bg-brand-surface p-2 rounded-xl transition-colors">
      <i data-lucide="x" class="w-5 h-5"></i>
    </button>

    <div class="flex items-center gap-2 font-heading font-bold text-lg text-white mb-4">
      <i data-lucide="clipboard-check" class="w-5 h-5 text-brand-mint"></i>
      Мои отклики на смены
    </div>

    <div id="applicationsList" class="space-y-3 max-h-80 overflow-y-auto pr-1"></div>
  </div>
</div>

<script>
  // Initialize Lucide icons
  lucide.createIcons();

  // Sample job data
  const jobs = [
    {
      id: 1,
      title: 'Промоутер в кофейне',
      company: 'Surf & Bake',
      category: 'promo',
      pay: 1650,
      hours: 3,
      location: 'м. Маяковская',
      description: 'Раздача флаеров с напитками'
    },
    {
      id: 2,
      title: 'Курьер пеший',
      company: 'Доставка Еды',
      category: 'courier',
      pay: 1950,
      hours: 4,
      location: 'м. Чистые пруды',
      description: 'Доставка заказов в радиусе 2 км'
    },
    {
      id: 3,
      title: 'Модератор карточек',
      company: 'Интернет-магазин',
      category: 'online',
      pay: 1500,
      hours: 2,
      location: 'Удаленно',
      description: 'Заполнение тегов и описаний'
    },
    {
      id: 4,
      title: 'Помощник на складе',
      company: 'Маркетплейс',
      category: 'assistant',
      pay: 1800,
      hours: 3,
      location: 'м. Павелецкая',
      description: 'Сортировка легких товаров'
    },
    {
      id: 5,
      title: 'Промоутер на фестивале',
      company: 'Event Agency',
      category: 'events',
      pay: 2200,
      hours: 4,
      location: 'Парк Горького',
      description: 'Раздача пробников на фестивале'
    },
    {
      id: 6,
      title: 'Помощник бариста',
      company: 'Кофейня "Утро"',
      category: 'promo',
      pay: 1700,
      hours: 3,
      location: 'м. Тверская',
      description: 'Помощь на кассе и раздача напитков'
    }
  ];

  let currentFilter = 'all';
  let calcRate = 550;

  // Render jobs
  function renderJobs() {
    const grid = document.getElementById('jobsGrid');
    const emptyState = document.getElementById('jobsEmptyState');
    const keyword = document.getElementById('filterKeywordInput').value.toLowerCase();
    const hoursFilter = document.getElementById('filterHoursSelect').value;
    const payFilter = parseInt(document.getElementById('filterPaySelect').value);

    let filtered = jobs.filter(job => {
      if (currentFilter !== 'all' && job.category !== currentFilter) return false;
      if (keyword && !job.title.toLowerCase().includes(keyword) && !job.location.toLowerCase().includes(keyword)) return false;
      if (hoursFilter !== 'any' && job.hours > parseInt(hoursFilter)) return false;
      if (payFilter > 0 && job.pay < payFilter) return false;
      return true;
    });

    if (filtered.length === 0) {
      grid.innerHTML = '';
      emptyState.classList.remove('hidden');
      document.getElementById('jobsCountBadge').textContent = '0';
      return;
    }

    emptyState.classList.add('hidden');
    document.getElementById('jobsCountBadge').textContent = filtered.length;

    grid.innerHTML = filtered.map(job => `
      <div class="bg-brand-card rounded-2xl border-2 border-brand-border hover:border-brand-mint transition-all hover:-translate-y-1 p-5">
        <div class="flex justify-between items-start mb-3">
          <span class="text-[10px] font-bold uppercase tracking-wider text-brand-yellow bg-brand-yellow/10 px-2 py-0.5 rounded">${getCategoryLabel(job.category)}</span>
          <span class="font-heading font-black text-brand-mint text-lg">${job.pay.toLocaleString()} ₽</span>
        </div>
        <h3 class="font-heading font-bold text-base text-white mb-1">${job.title}</h3>
        <p class="text-xs text-slate-300 mb-3">${job.company}</p>
        <p class="text-xs text-slate-400 mb-4">${job.description}</p>
        <div class="grid grid-cols-2 gap-2 mb-4 text-xs text-slate-300">
          <div class="flex items-center gap-1.5 bg-brand-surface p-2 rounded-lg">
            <i data-lucide="clock" class="w-3.5 h-3.5 text-brand-mint"></i>
            <span>${job.hours} часа</span>
          </div>
          <div class="flex items-center gap-1.5 bg-brand-surface p-2 rounded-lg">
            <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-yellow"></i>
            <span>${job.location}</span>
          </div>
        </div>
        <button onclick="openQuickApply(${job.id})" class="w-full bg-gradient-to-r from-brand-indigo to-brand-purple hover:brightness-110 text-white font-heading font-bold text-xs py-3 rounded-xl transition-all">
          Откликнуться
        </button>
      </div>
    `).join('');

    lucide.createIcons();
  }

  function getCategoryLabel(category) {
    const labels = {
      courier: '🚲 Курьер',
      promo: '📢 Промо',
      assistant: '📦 Помощник',
      online: '💻 Онлайн',
      events: '🎪 Ивенты'
    };
    return labels[category] || category;
  }

  function setCategoryFilter(category) {
    currentFilter = category;
    document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
    const btnId = category === 'all' ? 'btnFilterAll' : `btnFilter${category.charAt(0).toUpperCase() + category.slice(1)}`;
    document.getElementById(btnId)?.classList.add('active');
    renderJobs();
  }

  function applyFilters() {
    renderJobs();
  }

  function resetFilters() {
    currentFilter = 'all';
    document.getElementById('filterKeywordInput').value = '';
    document.getElementById('filterHoursSelect').value = 'any';
    document.getElementById('filterPaySelect').value = '0';
    document.querySelectorAll('.category-btn').forEach(btn => btn.classList.remove('active'));
    document.getElementById('btnFilterAll').classList.add('active');
    renderJobs();
  }

  function searchFromHero() {
    const location = document.getElementById('heroLocationInput').value;
    document.getElementById('filterKeywordInput').value = location;
    document.getElementById('vacancies').scrollIntoView({ behavior: 'smooth' });
    renderJobs();
  }

  function openQuickApply(jobId) {
    const job = jobs.find(j => j.id === jobId);
    if (!job) return;
    document.getElementById('modalJobTitle').textContent = job.title;
    document.getElementById('modalCompanyInfo').textContent = `${job.company} • ${job.pay} ₽ за смену`;
    document.getElementById('quickApplyModal').classList.remove('hidden');
    document.getElementById('quickApplyModal').classList.add('flex');
  }

  function closeQuickApplyModal() {
    document.getElementById('quickApplyModal').classList.add('hidden');
    document.getElementById('quickApplyModal').classList.remove('flex');
  }

  function submitApplication() {
    const name = document.getElementById('applyUserName').value;
    const age = document.getElementById('applyUserAge').value;
    const contact = document.getElementById('applyUserContact').value;
    
    if (!name || !contact) {
      showToast('Заполни все поля!');
      return;
    }

    showToast('Отклик отправлен! Подтверждение придет в течение 5 минут ⚡');
    closeQuickApplyModal();
  }

  function toggleAuthModal() {
    const modal = document.getElementById('authModal');
    modal.classList.toggle('hidden');
    modal.classList.toggle('flex');
  }

  function simulateTgLogin() {
    showToast('Успешный вход через Telegram!');
    toggleAuthModal();
    document.getElementById('authBtnLabel').textContent = '@artem_teen';
    document.getElementById('userBalanceBadge').classList.remove('hidden');
  }

  function closeApplicationsModal() {
    document.getElementById('applicationsModal').classList.add('hidden');
    document.getElementById('applicationsModal').classList.remove('flex');
  }

  function toggleAccordion(button) {
    const content = button.nextElementSibling;
    const icon = button.querySelector('i');
    
    if (content.classList.contains('hidden')) {
      content.classList.remove('hidden');
      content.classList.add('open');
      icon.style.transform = 'rotate(180deg)';
    } else {
      content.classList.add('hidden');
      content.classList.remove('open');
      icon.style.transform = 'rotate(0deg)';
    }
  }

  function updateCalculator() {
    const hours = parseFloat(document.getElementById('calcHoursRange').value);
    const days = parseInt(document.getElementById('calcDaysRange').value);
    
    document.getElementById('calcHoursLabel').textContent = `${hours} часа`;
    document.getElementById('calcDaysLabel').textContent = `${days} дней`;

    const daily = hours * calcRate;
    const weekly = daily * days;
    const monthly = weekly * 4;

    document.getElementById('calcMonthlyTotal').textContent = monthly.toLocaleString();
    document.getElementById('calcWeeklyNote').textContent = `≈ ${weekly.toLocaleString()} ₽ в неделю`;

    const goalPrice = 19990; // AirPods Pro
    const weeks = Math.ceil(goalPrice / weekly);
    document.getElementById('calcGoalWeeks').textContent = `~ ${weeks} недель`;
    
    const progress = Math.min((weekly * weeks) / goalPrice * 100, 100);
    document.getElementById('calcProgressBar').style.width = `${progress}%`;
  }

  function setCalcRate(rate, button) {
    calcRate = rate;
    document.querySelectorAll('.calc-rate-btn').forEach(btn => btn.classList.remove('active'));
    button.classList.add('active');
    updateCalculator();
  }

  function demoLiveApply() {
    showToast('Отклик на Live смену отправлен! Ожидай подтверждения ⚡');
  }

  function openSupportToast() {
    showToast('Чат поддержки открыт! Юрист ответит в течение 2 минут');
  }

  function showToast(message) {
    const toast = document.createElement('div');
    toast.className = 'toast';
    toast.textContent = message;
    document.body.appendChild(toast);
    
    setTimeout(() => {
      toast.remove();
    }, 3000);
  }

  // Initial render
  renderJobs();
</script>

</body>
</html>
