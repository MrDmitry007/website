<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QWENWORK - Безопасная подработка 14+</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            'heading': ['Inter', 'system-ui', 'sans-serif'],
            'mono': ['JetBrains Mono', 'monospace'],
          },
          colors: {
            brand: {
              'purple': '#8b5cf6',
              'indigo': '#6366f1',
              'mint': '#10b981',
              'mintHover': '#059669',
              'yellow': '#fbbf24',
              'pink': '#ec4899',
              'dark': '#0f172a',
              'surface': '#1e293b',
              'card': '#1e293b',
              'cardHover': '#334155',
              'border': '#334155',
            }
          },
          boxShadow: {
            'neo': '4px 4px 0px 0px rgba(16, 185, 129, 0.3)',
            'neo-yellow': '4px 4px 0px 0px rgba(251, 191, 36, 0.4)',
            'neo-pink': '4px 4px 0px 0px rgba(236, 72, 153, 0.4)',
            'glow-purple': '0 0 40px rgba(139, 92, 246, 0.3)',
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono&display=swap');
    
    body {
      background-color: #0f172a;
      font-family: 'Inter', sans-serif;
    }
    
    .badge-tilt-1 {
      transform: rotate(-3deg);
    }
    
    .badge-tilt-2 {
      transform: rotate(3deg);
    }
    
    .category-btn.active {
      background-color: #10b981 !important;
      color: #0f172a !important;
      border-color: #10b981 !important;
    }
    
    .calc-rate-btn.active {
      background-color: #10b981 !important;
      color: #0f172a !important;
      border-color: #10b981 !important;
    }
    
    .accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease-out;
    }
    
    .accordion-content.open {
      max-height: 500px;
    }
    
    .toast {
      position: fixed;
      bottom: 2rem;
      left: 50%;
      transform: translateX(-50%);
      background-color: #10b981;
      color: #0f172a;
      padding: 0.75rem 1.5rem;
      border-radius: 0.75rem;
      font-weight: 600;
      box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);
      z-index: 9999;
      animation: slideUp 0.3s ease-out;
    }
    
    @keyframes slideUp {
      from {
        transform: translateX(-50%) translateY(100%);
        opacity: 0;
      }
      to {
        transform: translateX(-50%) translateY(0);
        opacity: 1;
      }
    }
  </style>
</head>
<body class="text-slate-200">

<!-- Header -->
<div class="sticky top-0 z-50 bg-brand-dark/95 backdrop-blur-md border-b border-brand-border">
<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between h-16 gap-4">
    <!-- Logo -->
    <a href="#" class="flex items-center gap-3 group">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-brand-purple to-brand-indigo flex items-center justify-center border-2 border-brand-mint shadow-neo transition-transform group-hover:scale-105">
        <i data-lucide="shield-check" class="w-6 h-6 text-brand-mint stroke-[2.5]"></i>
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="font-heading font-black text-xl tracking-tight text-white">QWEN<span class="text-brand-mint">WORK</span></span>
          <span class="text-[10px] uppercase font-bold tracking-wider bg-brand-yellow text-brand-dark px-1.5 py-0.5 rounded font-heading">14-17</span>
        </div>
        <p class="text-xs text-slate-400 font-medium">Безопасная подработка рядом</p>
      </div>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-8 text-sm font-semibold">
      <a href="#vacancies" class="text-slate-300 hover:text-brand-mint transition-colors flex items-center gap-1.5">
        <i data-lucide="briefcase" class="w-4 h-4"></i> Вакансии
      </a>
      <a href="#safety" class="text-slate-300 hover:text-brand-mint transition-colors flex items-center gap-1.5">
        <i data-lucide="shield" class="w-4 h-4"></i> Гарантии
      </a>
      <a href="#calculator" class="text-slate-300 hover:text-brand-mint transition-colors flex items-center gap-1.5">
        <i data-lucide="calculator" class="w-4 h-4"></i> Калькулятор дохода
      </a>
      <a href="#parents" class="text-slate-300 hover:text-brand-mint transition-colors flex items-center gap-1.5">
        <i data-lucide="heart-handshake" class="w-4 h-4"></i> Родителям
      </a>
    </nav>

    <!-- User Controls -->
    <div class="flex items-center gap-3">
      <div id="userBalanceBadge" class="hidden sm:flex items-center gap-2 px-3.5 py-1.5 bg-brand-surface rounded-xl border border-brand-border">
        <span class="w-2 h-2 rounded-full bg-brand-mint animate-pulse"></span>
        <span class="text-xs text-slate-300">Баланс:</span>
        <span id="headerBalance" class="text-xs font-bold text-brand-yellow">1 850 ₽</span>
      </div>

      <button onclick="toggleAuthModal()" class="flex items-center gap-2 bg-gradient-to-r from-brand-purple to-brand-indigo hover:brightness-110 text-white font-heading font-semibold text-xs sm:text-sm px-4 py-2.5 rounded-xl border-2 border-brand-mint shadow-neo transition-all active:translate-x-1 active:translate-y-1 active:shadow-none">
        <i data-lucide="send" class="w-4 h-4 text-brand-mint"></i>
        <span id="authBtnLabel">Войти в 1 клик</span>
      </button>
    </div>
  </div>
</div>
</div>

<!-- Hero Section -->
<section class="relative pt-10 pb-16 md:pt-16 md:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
  
  <div class="flex flex-wrap items-center gap-2 mb-6">
    <span class="inline-flex items-center gap-2 bg-brand-purple/40 border border-brand-purple text-brand-mint px-3.5 py-1.5 rounded-full text-xs font-semibold tracking-wide backdrop-blur-sm">
      <i data-lucide="badge-check" class="w-4 h-4 text-brand-mint"></i>
      Без резюме и 18+ ограничений
    </span>
    <span class="inline-flex items-center gap-1.5 bg-brand-yellow/15 border border-brand-yellow/40 text-brand-yellow px-3 py-1.5 rounded-full text-xs font-semibold">
      ⚡ Выплаты сегодня на любую карту
    </span>
  </div>

  <div class="grid lg:grid-cols-12 gap-10 items-center">
    
    <div class="lg:col-span-7">
      <h1 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight leading-[1.15] text-white uppercase mb-6">
        Первые деньги <br class="hidden sm:inline"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-mint via-brand-yellow to-brand-mint">
          без риска и обмана.
        </span><br/>
        Легально 14+.
      </h1>
      <p class="text-slate-300 text-base sm:text-lg max-w-2xl leading-relaxed mb-8">
        Проверенные микро-вакансии от кофеен, магазинов и ивентов твоего района. 
        Смены от 2 до 4 часов, безопасная сделка и белые выплаты без бюрократии.
      </p>

      <!-- Search Widget -->
      <div class="bg-brand-card p-3 sm:p-4 rounded-2xl border-2 border-brand-border shadow-2xl max-w-2xl">
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-grow">
            <i data-lucide="map-pin" class="w-5 h-5 text-brand-mint absolute left-3.5 top-1/2 -translate-y-1/2"></i>
            <input 
              type="text" 
              id="heroLocationInput"
              placeholder="Введи метро или район (напр. Центр)" 
              class="w-full bg-brand-surface text-sm text-white placeholder-slate-400 pl-11 pr-4 py-3 rounded-xl border border-brand-border focus:outline-none focus:border-brand-mint transition-colors"
            />
          </div>
          <button 
            onclick="searchFromHero()"
            class="bg-brand-mint hover:bg-brand-mintHover text-brand-dark font-heading font-bold text-sm px-6 py-3.5 rounded-xl transition-all shadow-neo flex items-center justify-center gap-2 active:translate-x-0.5 active:translate-y-0.5 whitespace-nowrap">
            <i data-lucide="search" class="w-4 h-4"></i>
            Найти смену
          </button>
        </div>

        <!-- Fast Quick-tags -->
        <div class="flex items-center gap-2 mt-4 pt-3 border-t border-brand-border/60 overflow-x-auto pb-1 text-xs">
          <span class="text-slate-400 whitespace-nowrap font-medium">Популярно:</span>
          <button onclick="setCategoryFilter('courier')" class="px-2.5 py-1 rounded-lg bg-brand-surface hover:bg-brand-purple/40 text-slate-200 border border-brand-border whitespace-nowrap transition-colors">🚲 Курьер</button>
          <button onclick="setCategoryFilter('promo')" class="px-2.5 py-1 rounded-lg bg-brand-surface hover:bg-brand-purple/40 text-slate-200 border border-brand-border whitespace-nowrap transition-colors">📢 Промоутер</button>
          <button onclick="setCategoryFilter('online')" class="px-2.5 py-1 rounded-lg bg-brand-surface hover:bg-brand-purple/40 text-slate-200 border border-brand-border whitespace-nowrap transition-colors">💻 На дому</button>
          <button onclick="setCategoryFilter('events')" class="px-2.5 py-1 rounded-lg bg-brand-surface hover:bg-brand-purple/40 text-slate-200 border border-brand-border whitespace-nowrap transition-colors">🎪 Ивенты</button>
        </div>
      </div>

      <!-- Key Metrics -->
      <div class="grid grid-cols-3 gap-3 sm:gap-6 mt-8 max-w-xl">
        <div class="bg-brand-card/70 border border-brand-border rounded-xl p-3">
          <p class="font-heading font-black text-xl sm:text-2xl text-brand-mint">100%</p>
          <p class="text-xs text-slate-400 mt-1 leading-tight">Проверено по ИНН и базам</p>
        </div>
        <div class="bg-brand-card/70 border border-brand-border rounded-xl p-3">
          <p class="font-heading font-black text-xl sm:text-2xl text-brand-yellow">1 850 ₽</p>
          <p class="text-xs text-slate-400 mt-1 leading-tight">Средний чек за 3 часа смены</p>
        </div>
        <div class="bg-brand-card/70 border border-brand-border rounded-xl p-3">
          <p class="font-heading font-black text-xl sm:text-2xl text-brand-indigo">0 ₽</p>
          <p class="text-xs text-slate-400 mt-1 leading-tight">Никаких взносов за старт</p>
        </div>
      </div>

    </div>

    <!-- Visual Hero Card -->
    <div class="lg:col-span-5 relative">
      <div class="relative mx-auto max-w-md">
        
        <div class="absolute -top-5 -left-4 z-20 bg-brand-yellow text-brand-dark px-3 py-1.5 rounded-lg font-heading font-black text-xs shadow-neo-yellow badge-tilt-1 flex items-center gap-1.5">
          <i data-lucide="zap" class="w-4 h-4 fill-brand-dark"></i> ДЕНЬГИ В ТОТ ЖЕ ДЕНЬ
        </div>

        <div class="absolute -bottom-4 -right-2 z-20 bg-brand-pink text-white px-3 py-1.5 rounded-lg font-heading font-bold text-xs shadow-neo-pink badge-tilt-2 flex items-center gap-1.5">
          <i data-lucide="check-check" class="w-4 h-4"></i> БЕЗ СКАМА
        </div>

        <div class="bg-brand-card rounded-3xl border-2 border-brand-border p-5 shadow-glow-purple relative overflow-hidden">
          <div class="flex items-center justify-between border-b border-brand-border pb-3 mb-4">
            <div class="flex items-center gap-2">
              <div class="w-3 h-3 rounded-full bg-red-500"></div>
              <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
            </div>
            <span class="text-[11px] font-mono text-brand-mint uppercase tracking-wider">Live Смена #419</span>
          </div>

          <div class="bg-brand-surface rounded-2xl p-4 border border-brand-border mb-4">
            <div class="flex justify-between items-start">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-brand-yellow bg-brand-yellow/10 px-2 py-0.5 rounded">Пеший помощник</span>
                <h3 class="font-heading font-bold text-base text-white mt-1.5">Сеть кофеен «Surf & Bake»</h3>
                <p class="text-xs text-slate-300 mt-1">Раздача промо-флаеров с напитками</p>
              </div>
              <span class="font-heading font-black text-brand-mint text-base whitespace-nowrap">1 900 ₽</span>
            </div>

            <div class="grid grid-cols-2 gap-2 mt-4 text-xs text-slate-300">
              <div class="flex items-center gap-1.5 bg-brand-dark/50 p-2 rounded-lg">
                <i data-lucide="clock" class="w-3.5 h-3.5 text-brand-mint"></i>
                <span>3 часа (15:00-18:00)</span>
              </div>
              <div class="flex items-center gap-1.5 bg-brand-dark/50 p-2 rounded-lg">
                <i data-lucide="map-pin" class="w-3.5 h-3.5 text-brand-yellow"></i>
                <span>350 м от м. Маяковская</span>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-brand-border/60 flex items-center justify-between">
              <div class="flex items-center gap-1.5 text-emerald-400 text-xs font-semibold">
                <i data-lucide="shield-alert" class="w-4 h-4"></i>
                <span>Оплата задепонирована</span>
              </div>
              <span class="text-[11px] text-slate-400">Свободно 2 места</span>
            </div>
          </div>

          <div class="space-y-2.5">
            <div class="flex items-center gap-2.5 text-xs text-slate-300">
              <div class="w-5 h-5 rounded-full bg-brand-mint/20 text-brand-mint flex items-center justify-center shrink-0">
                <i data-lucide="check" class="w-3.5 h-3.5"></i>
              </div>
              <span>Работодатель подтвердил паспорт и ОГРНИП</span>
            </div>
            <div class="flex items-center gap-2.5 text-xs text-slate-300">
              <div class="w-5 h-5 rounded-full bg-brand-mint/20 text-brand-mint flex items-center justify-center shrink-0">
                <i data-lucide="check" class="w-3.5 h-3.5"></i>
              </div>
              <span>Оплата переводится сразу по завершению задания</span>
            </div>
          </div>

          <button onclick="demoLiveApply()" id="liveDemoCardBtn" class="mt-5 w-full bg-gradient-to-r from-brand-indigo to-brand-purple hover:brightness-110 text-white font-heading font-bold text-xs py-3 rounded-xl border border-brand-mint/50 transition-all flex items-center justify-center gap-2">
            <i data-lucide="sparkles" class="w-4 h-4 text-brand-mint"></i>
            <span id="liveDemoBtnText">Проверить моментальный отклик</span>
          </button>

        </div>

      </div>
    </div>

  </div>

</section>

<!-- Safety / Trust Triggers -->
<section id="safety" class="py-14 bg-brand-card/40 border-y border-brand-border relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-surface border border-brand-border text-brand-yellow text-xs font-semibold mb-3">
        <i data-lucide="shield-check" class="w-4 h-4 text-brand-yellow"></i>
        Почему мы не скам
      </div>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-black text-white uppercase tracking-tight">
        Тройная защита от <span class="text-brand-pink">обмана и серых схем</span>
      </h2>
      <p class="text-slate-300 text-sm sm:text-base mt-3">
        Мы лично тестируем каждого заказчика. Никаких «залогов за материал», подозрительных курьеров и бесконечных неоплачиваемых стажировок.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      <div class="bg-brand-card rounded-2xl p-6 border-2 border-brand-border hover:border-brand-mint transition-all hover:-translate-y-1 group">
        <div class="w-12 h-12 rounded-xl bg-brand-mint/10 border border-brand-mint flex items-center justify-center text-brand-mint mb-5 group-hover:scale-110 transition-transform">
          <i data-lucide="scale" class="w-6 h-6"></i>
        </div>
        <h3 class="font-heading font-bold text-lg text-white mb-2">Строго по ТК РФ (14+)</h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          Не более 2.5–4 часов в день во внеучебное время. Никаких ночных смен, опасных производств или подъема тяжестей. Всё в рамках закона РФ.
        </p>
        <div class="mt-4 pt-3 border-t border-brand-border text-xs text-brand-mint font-semibold flex items-center gap-1">
          <i data-lucide="check" class="w-3.5 h-3.5"></i> Без вреда для учебы
        </div>
      </div>

      <div class="bg-brand-card rounded-2xl p-6 border-2 border-brand-border hover:border-brand-yellow transition-all hover:-translate-y-1 group">
        <div class="w-12 h-12 rounded-xl bg-brand-yellow/10 border border-brand-yellow flex items-center justify-center text-brand-yellow mb-5 group-hover:scale-110 transition-transform">
          <i data-lucide="lock" class="w-6 h-6"></i>
        </div>
        <h3 class="font-heading font-bold text-lg text-white mb-2">Безопасная сделка (Эскроу)</h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          Заказчик переводит деньги на счет платформы ДО начала твоей смены. Когда задание выполнено — деньги мгновенно поступают на твою карту или СБП.
        </p>
        <div class="mt-4 pt-3 border-t border-brand-border text-xs text-brand-yellow font-semibold flex items-center gap-1">
          <i data-lucide="check" class="w-3.5 h-3.5"></i> Гарантия 100% выплаты
        </div>
      </div>

      <div class="bg-brand-card rounded-2xl p-6 border-2 border-brand-border hover:border-brand-purple transition-all hover:-translate-y-1 group">
        <div class="w-12 h-12 rounded-xl bg-brand-purple/20 border border-brand-purple flex items-center justify-center text-brand-indigo mb-5 group-hover:scale-110 transition-transform">
          <i data-lucide="user-check" class="w-6 h-6 text-brand-mint"></i>
        </div>
        <h3 class="font-heading font-bold text-lg text-white mb-2">Ручной скоринг компаний</h3>
        <p class="text-sm text-slate-300 leading-relaxed">
          Модераторы проверяют ИНН, регистрацию в налоговой, отзывы и локацию. Любые сомнительные вакансии блокируются до публикации.
        </p>
        <div class="mt-4 pt-3 border-t border-brand-border text-xs text-slate-300 font-semibold flex items-center gap-1">
          <i data-lucide="check" class="w-3.5 h-3.5 text-brand-mint"></i> 0% сомнительных предложений
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Vacancies Feed -->
<section id="vacancies" class="py-16 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
    <div>
      <span class="text-xs uppercase font-heading font-bold tracking-wider text-brand-mint">Биржа проверенных заказов</span>
      <h2 class="font-heading text-2xl sm:text-3xl font-black text-white uppercase mt-1">Доступные смены рядом</h2>
      <p class="text-sm text-slate-400 mt-1">Откликайся без резюме — подтверждение за 5 минут</p>
    </div>

    <div class="flex items-center gap-2">
      <span class="text-xs text-slate-400">Найдено: <strong id="jobsCountBadge" class="text-brand-mint">6</strong> предложений</span>
    </div>
  </div>

  <!-- Filters Panel -->
  <div class="bg-brand-card p-4 rounded-2xl border border-brand-border mb-8 space-y-4">
    
    <div class="flex items-center gap-2 overflow-x-auto pb-1">
      <button onclick="setCategoryFilter('all')" id="btnFilterAll" class="category-btn active px-4 py-2 rounded-xl text-xs font-heading font-bold transition-all bg-brand-mint text-brand-dark shadow-neo">
        Все категории
      </button>
      <button onclick="setCategoryFilter('courier')" id="btnFilterCourier" class="category-btn px-4 py-2 rounded-xl text-xs font-heading font-bold transition-all bg-brand-surface text-slate-300 hover:text-white border border-brand-border">
        🚲 Курьер / Доставка
      </button>
      <button onclick="setCategoryFilter('promo')" id="btnFilterPromo" class="category-btn px-4 py-2 rounded-xl text-xs font-heading font-bold transition-all bg-brand-surface text-slate-300 hover:text-white border border-brand-border">
        📢 Раздача флаеров
      </button>
      <button onclick="setCategoryFilter('assistant')" id="btnFilterAssistant" class="category-btn px-4 py-2 rounded-xl text-xs font-heading font-bold transition-all bg-brand-surface text-slate-300 hover:text-white border border-brand-border">
        📦 Помощник / Склад
      </button>
      <button onclick="setCategoryFilter('online')" id="btnFilterOnline" class="category-btn px-4 py-2 rounded-xl text-xs font-heading font-bold transition-all bg-brand-surface text-slate-300 hover:text-white border border-brand-border">
        💻 Онлайн / IT
      </button>
      <button onclick="setCategoryFilter('events')" id="btnFilterEvents" class="category-btn px-4 py-2 rounded-xl text-xs font-heading font-bold transition-all bg-brand-surface text-slate-300 hover:text-white border border-brand-border">
        🎪 Фестивали / Ивенты
      </button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 border-t border-brand-border/60">
      <div>
        <label class="block text-[11px] font-semibold text-slate-400 mb-1">Поиск по названию или метро:</label>
        <div class="relative">
          <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
          <input 
